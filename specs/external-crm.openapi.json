{
  "openapi": "3.0.0",
  "info": {
    "title": "外部 CRM（存量系统沙箱）",
    "version": "1.0.0",
    "description": "EB-1 Enterprise Capability Bridge 演示：模拟一个既有 CRM 系统（不替换），经 AI Bridge（--import-openapi-proxy）接入 KeelBase，让 AI 在治理约束下读取/写回。读操作 = R1（自动执行），写操作 = R3（需人工确认）。"
  },
  "paths": {
    "/customers": {
      "get": {
        "operationId": "listCustomers",
        "summary": "客户列表（读）",
        "description": "按关键字查询客户（AI 风险分析的数据来源之一）",
        "parameters": [
          { "name": "keyword", "in": "query", "schema": { "type": "string" }, "description": "关键字（名称/公司）" }
        ],
        "responses": { "200": { "description": "客户数组" } }
      }
    },
    "/customers/{id}": {
      "get": {
        "operationId": "getCustomer",
        "summary": "客户详情（读）",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "客户详情" } }
      }
    },
    "/customers/{id}/orders": {
      "get": {
        "operationId": "listCustomerOrders",
        "summary": "客户订单（读）",
        "description": "该客户的订单列表——风险分析（逾期/金额）依据",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "订单数组" } }
      }
    },
    "/customers/{id}/followups": {
      "post": {
        "operationId": "createFollowupTask",
        "summary": "创建跟进任务（写，R3 需人工确认）",
        "description": "在外部 CRM 创建跟进任务——AI 写回外部系统，走确认门控 + 副作用登记（B 路径 proxy_call，撤销走 Java 补偿）",
        "x-keelbase-risk-level": "R3",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["content"],
                "properties": {
                  "content": { "type": "string", "description": "跟进内容" },
                  "dueDate": { "type": "string", "description": "截止日期" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "跟进任务已创建" } }
      }
    },
    "/customers/{id}/orders/{orderId}": {
      "patch": {
        "operationId": "updateOrderAmount",
        "summary": "修改订单金额（高风险，R3 需人工确认）",
        "description": "折扣/改价类写操作——演示企业最关心的高风险 AI 动作（需审批）",
        "x-keelbase-risk-level": "R3",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount"],
                "properties": { "amount": { "type": "number", "description": "新金额" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "已更新" } }
      }
    }
  }
}
