{
  "name": "web-admin",
  "version": "1.0.5",
  "private": true,
  "description": "KeelBase Web host: workbench + admin console (Vue3 + Element Plus) — 工作台 + 管理台同一壳",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:admin": "vite build --mode admin",
    "build:user": "vite build --mode user",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.1.0",
    "@mdi/font": "^7.4.47",
    "axios": "^1.7.9",
    "element-plus": "^2.14.4",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
