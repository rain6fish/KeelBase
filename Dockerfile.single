# ---- EASY-1 单容器 all-in-one 交付 ----
# `docker run -p 80:3000 ghcr.io/rain6fish/keelbase:single` 一条命令可用
# 一个镜像 = 后端 API + Flutter web 主 App + 管理台，SQLite 零配置 + Redis 降级。
# 大项目仍用 docker-compose.yml（多容器 postgres+redis）。
# 用法：docker build -f Dockerfile.single -t keelbase:single . && docker run -p 80:3000 keelbase:single

# Base images are pinned by digest. A floating tag is what let the 2026-11 audit find JVMs below the
# fix line with nothing in CI saying so: `node:22-alpine` moves underneath a rebuild, and a container
# built before the move keeps the base it was created from. The readable tag stays in the reference
# beside the digest, so the pin still says what it means.
#
# This is the image `docker-publish.yml` ships to ghcr.io, so the digest here is what users of the
# published image actually get. To refresh, read the digest at the moment you pin it, confirm what is
# inside, then replace it here and rebuild:
#   docker pull node:22-alpine
#   docker inspect node:22-alpine --format '{{index .RepoDigests 0}}'
#   docker run --rm --entrypoint node node:22-alpine --version
# Do not paste a digest from a report — tags move, and an older read points at an older image.
#
# 基础镜像按摘要钉住。浮动标签正是 2026-11 那次安全排查里「JVM 低于修复线、CI 却什么也不报」的成因：
# `node:22-alpine` 会在重建之下悄悄换掉，而在此之前构建出的容器留着它被创建时那份基础镜像。
# 可读的标签保留在摘要旁边，用来说明这个钉住的是什么。
#
# 这个文件就是 `docker-publish.yml` 推到 ghcr.io 的那个镜像，所以这里的摘要就是已发布镜像的用户真正拿到的。
# 升级时：在钉的那一刻读出摘要、确认里面是什么，再替换这里并重建：
#   docker pull node:22-alpine
#   docker inspect node:22-alpine --format '{{index .RepoDigests 0}}'
#   docker run --rm --entrypoint node node:22-alpine --version
# 不要把某份报告里的摘要抄过来 —— 标签会移动，抄来的旧摘要指向旧镜像。

# ---- Backend build ----
FROM node:22-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202 AS server-build
WORKDIR /app/server
# 中国网络 npm 官方 tarball 常不可达；默认阿里镜像，海外构建用 --build-arg NPM_REGISTRY=https://registry.npmjs.org 覆盖
ARG NPM_REGISTRY=https://registry.npmmirror.com
ENV NPM_CONFIG_REGISTRY=$NPM_REGISTRY
# better-sqlite3 原生编译需要工具链（prebuild 下载受 GitHub 网络影响时回退 node-gyp）
RUN apk add --no-cache python3 make g++
COPY Server-NestJS/package*.json ./
RUN npm ci --include=dev
COPY Server-NestJS/ .
RUN npm run build
# 编译 seed-demo 脚本到 build-seed/（nest build 不含 scripts/）；synchronize 建表 + 幂等补种演示账号
RUN npx tsc scripts/seed-demo.ts --outDir build-seed --rootDir . --module commonjs --target es2020 --esModuleInterop --skipLibCheck --experimentalDecorators --emitDecoratorMetadata --moduleResolution node

# ---- Flutter web build ----
# 注：flutter build web 在容器内（BuildKit）偶发 dart2js 崩溃且无一致根因（宿主机/交互容器稳定）。
# 改为宿主机构建产物，Dockerfile 只 COPY build/web —— 确定性最高，也更快。
FROM scratch AS flutter-build
COPY Front-Flutter/build/web /build/web

# ---- Admin console build (Vue3 PC Web, /admin sub-path) ----
FROM node:22-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202 AS admin-build
WORKDIR /app/admin
ARG NPM_REGISTRY=https://registry.npmmirror.com
ENV NPM_CONFIG_REGISTRY=$NPM_REGISTRY
COPY Web-Admin-Vue/package*.json ./
RUN npm ci
COPY Web-Admin-Vue/ .
RUN npm run build

# ---- Single runtime image ----
FROM node:22-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202 AS single
WORKDIR /app/server
RUN apk add --no-cache wget
# The runtime never runs npm: the entrypoint is `node dist/main`, and the seed scripts run with
# `node` too. The npm bundled in the base image is therefore the only source of the pinned base's
# fixable HIGH findings; removing it takes the publish gate from 10 findings to 0 without touching
# the gate's severity, exit-code or ignore rules.
# 运行阶段从不执行 npm：入口是 `node dist/main`，种子脚本同样用 `node`。所以基础镜像自带的 npm 是
# 钉住基础里唯一可修 HIGH 的来源；删掉它，发布门禁由 10 条归零，且不改动门禁的 severity、退出码或
# 忽略规则。
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
RUN addgroup -S keelbase && adduser -S keelbase -G keelbase && \
    mkdir -p /app/server/uploads /app/server/data /app/server/public/admin && \
    chown -R keelbase:keelbase /app/server
COPY --from=server-build /app/server/dist ./dist
COPY --from=server-build /app/server/build-seed ./build-seed
COPY --from=server-build /app/server/node_modules ./node_modules
COPY --from=server-build /app/server/package*.json ./
# 内嵌 Flutter web 主 App（根路径） + 管理台（/admin）
# admin-build outDir=dist/admin，COPY dist ./public → public/admin（SERVE_STATIC adminDir 匹配）
COPY --from=flutter-build /build/web ./public/mobile
COPY --from=admin-build /app/admin/dist ./public
# 单容器默认 SQLite + 降级 Redis/队列（大项目用 compose 覆盖这些 env）
# 安全密钥：内置 dev 默认值保证 `docker run` 零配置可用；生产部署请用 -e 覆盖真实密钥
# AI（P0-0）：未配置 DEEPSEEK/QWEN/OPENAI key 且无 OLLAMA_BASE_URL 时，自动注册确定性 Demo Provider——
#   `docker run` 零配置即可跑通 AI 黄金流程（分析→确认→创建跟进→审计→撤销），AI 文本为模板化回复；
#   配置真实 key（-e DEEPSEEK_API_KEY=...）后自动用真实 LLM（默认降级链 deepseek→qwen→openai→demo）。
ENV NODE_ENV=production \
    DB_TYPE=sqlite \
    CACHE_ENABLED=false \
    QUEUE_ENABLED=false \
    SERVE_STATIC=1 \
    DB_SYNCHRONIZE=true \
    PORT=3000 \
    JWT_SECRET=keelbase-single-container-dev-secret-at-least-32-chars!! \
    JWT_REFRESH_SECRET=keelbase-single-container-refresh-secret-32chars!! \
    ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef \
    ENCRYPTION_HMAC_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
EXPOSE 3000
USER keelbase
# 一键部署零配置：先补种演示账号（admin + alex，幂等），再启动后端
CMD ["sh", "-c", "node build-seed/scripts/seed-demo.js --username admin --password 'Admin@2026$KeelBase' || true; node build-seed/scripts/seed-demo.js --username alex --password 'Alex@2026$Demo' || true; node dist/main"]
