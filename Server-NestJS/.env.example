# ======================
# 环境
# ======================
NODE_ENV=development            # development | staging | production（决定 seed/迁移/Swagger 行为）

# ======================
# 服务器配置
# ======================
PORT=3000                       # 后端 HTTP 端口
CORS_ORIGINS=*                  # 允许跨域来源；生产改为具体域名，逗号分隔

# ======================
# JWT 认证配置（生产环境务必修改以下密钥）
# ======================
JWT_SECRET=change-me-jwt-secret-at-least-32-characters!!    # access token 签名密钥，≥32 字符
JWT_EXPIRES_IN=15m              # access token 有效期（如 15m / 1h）
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars!!  # refresh token 签名密钥，≥32 字符
JWT_REFRESH_EXPIRES_IN=7d       # refresh token 有效期

# ======================
# 数据库基础配置 (文档规范)
# ======================
DB_TYPE=sqlite                  # sqlite（开发零配置）| postgres（生产推荐）
DB_HOST=localhost               # postgres 主机
DB_PORT=5432                    # postgres 端口
DB_NAME=front                   # postgres 库名
DB_USER=postgres                # postgres 用户
DB_PASSWORD=postgres            # postgres 密码（生产务必改强密码）
DB_PATH=./data/front.sqlite     # SQLite 专用：数据库文件路径

# ======================
# 连接池配置 (初期推荐保守配置)
# ======================
DB_POOL_MAX=20                  # 连接池最大连接数
DB_POOL_MIN=5                   # 连接池最小连接数
DB_POOL_IDLE_TIMEOUT=30000      # 空闲连接超时（毫秒）
DB_POOL_CONNECTION_TIMEOUT=2000 # 获取连接超时（毫秒）

# ======================
# 安全设置
# ======================
# 连续登录失败阈值（超过则锁定账户）
LOCKOUT_THRESHOLD=10
# 账户锁定时间（分钟）
LOCKOUT_DURATION=15

# ======================
# 敏感数据加密
# ======================
# 32 字节 hex（openssl rand -hex 32）。必填。
# ⚠ 下面这行是「开发/演示」用固定值，让 cp .env.example .env 后能直接启动；
#   生产/私有化部署必须用 `openssl rand -hex 32` 生成并替换（deploy.sh 会自动做）。
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# providerHash 派生密钥，32 字节 hex，缺省回退用 ENCRYPTION_KEY
ENCRYPTION_HMAC_KEY=

# ======================
# OAuth 第三方登录（国内 + 国际）
# ======================
# 控制哪些认证方式可用，逗号分隔。默认启用国内认证（wechat,alipay,qq）
# 如需加国际认证，在下方补充:
# OAUTH_ENABLED_PROVIDERS=google,apple,wechat,alipay,qq

# 国内认证（默认启用）
# 微信开放平台（https://open.weixin.qq.com/）
# WECHAT_APP_ID=wx1234567890abcdef
# WECHAT_APP_SECRET=abcdef1234567890abcdef1234567890
# MINI-2 微信订阅消息：事件提醒模板 ID（小程序后台申请；空则不发送）
# WECHAT_REMIND_TEMPLATE_ID=
#
# 支付宝开放平台（https://open.alipay.com/）
# ALIPAY_APP_ID=2021001111666666
# ALIPAY_PUBLIC_KEY=支付宝公钥（验证支付宝响应）
# ALIPAY_PRIVATE_KEY=应用私钥（签名请求，PKCS1/PKCS8 格式）

# 国际认证（如需开启请取消注释）
# 从 Google Cloud Console → APIs & Services → Credentials 获取
# GOOGLE_CLIENT_ID=123456789-xxxxx.apps.googleusercontent.com
#
# 从 Apple Developer Portal 获取 Service ID
# APPLE_CLIENT_ID=com.example.front

# ======================
# 邮件服务（SMTP）
# ======================
# MAIL_ENABLED=false          # 设为 true 开启邮件发送
# SMTP_HOST=smtp.example.com  # SMTP 服务器地址
# SMTP_PORT=465               # 465=SSL / 587=STARTTLS
# SMTP_SECURE=true            # 是否启用 TLS（465 用 true，587 用 false）
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=KeelBase <no-reply@example.com>

# ======================
# 对象存储
# ======================
# STORAGE_DRIVER=local            # local（本地磁盘）| s3（S3/MinIO/OSS 兼容）
# S3_ENDPOINT=                    # 本地 MinIO 时填 http://localhost:9000
# S3_REGION=us-east-1             # 对象存储区域（MinIO 可填 us-east-1）
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=                  # 可选，对象公网前缀；留空用 bucket URL

# ======================
# Redis 缓存
# ======================
# REDIS_URL=redis://localhost:6379   # Redis 地址
# CACHE_ENABLED=true                 # 是否启用缓存层（false 降级直查库）
# CACHE_TTL=300                      # 默认缓存 TTL（秒）

# ======================
# RAG 向量检索（AI-5）
# ======================
# 向量功能可用条件：VECTOR_SEARCH_ENABLED=true + DB_TYPE=postgres + EMBEDDING_API_KEY + EMBEDDING_MODEL
# 任一不满足自动降级为全文搜索（LIKE 匹配）
# VECTOR_SEARCH_ENABLED=true            # 总开关
# EMBEDDING_BASE_URL=                   # OpenAI 兼容 embeddings 端点基址（如 https://api.openai.com/v1）
# EMBEDDING_API_KEY=                    # 嵌入 API key
# EMBEDDING_MODEL=text-embedding-3-small # 嵌入模型（维度须与迁移一致）
# EMBEDDING_DIMENSIONS=1536              # 向量维度（对应迁移 vector(1536)）

# ======================
# AI 模型配置（可选；不配置则 AI 功能降级/不可用）
# ======================
# AI_PROVIDER=deepseek                   # deepseek | qwen | openai | ollama（默认 deepseek；ollama 走本地）
# AI_CHAT_MODEL=deepseek-v4-flash        # 默认对话模型（各 provider 可单独覆盖）
# AI_MAX_TOKENS=4096                     # 单次回复最大 token 数
# AI_TEMPERATURE=0.7                     # 生成温度（0-2，越高越随机）
# 按 AI_PROVIDER 配置对应 Key 与 Base URL（配了哪个 provider 哪个可用）：
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CONVERSATION_TTL=3600                  # 对话上下文有效期（秒）

# 异步队列（BullMQ）
# QUEUE_ENABLED=true                  # 是否启用队列（false 降级同步执行）

# ======================
# 特性开关（PL-8/EASY-3）
# ======================
# 默认按 APP_PRESET 判定（full=全开），显式 true/false 覆盖对应特性（关闭后相关接口返回 404）
# APP_PRESET=full             # full（全开）| small（关 push/sms/oauth 外部集成）| lite（再关搜索+生成模块）
# FEATURE_AI_ENABLED=true
# FEATURE_SEARCH_ENABLED=true
# FEATURE_PUSH_ENABLED=true
# FEATURE_SMS_ENABLED=true
# FEATURE_OAUTH_ENABLED=true
# FEATURE_UPLOAD_ENABLED=true
# FEATURE_NOTIFICATIONS_ENABLED=true
# FEATURE_TODOS_ENABLED=true

# 定时任务（PL-7）
# NOTIFICATION_RETENTION_DAYS=30     # 已读通知保留天数，超期由定时清理

# ======================
# 动态配置中心（RG-2，Settings 表）
# ======================
# 由管理台 GET/PUT /settings 实时维护，无需 env/重启：
#   maintenance_mode（boolean）— 维护模式，true 时非 admin 请求 503
#   ai_daily_limit（number）   — 用户每日 AI 调用上限，0=不限（默认），超出抛 AI_DAILY_LIMIT
#   ai_system_prompt（string） — 覆盖默认 AI system prompt（AI-17，热生效）

# ======================
# 联网搜索（AI-14）
# ======================
# web_search 工具用 Tavily 搜索；未配置时工具返回降级提示
# TAVILY_API_KEY=
# TAVILY_BASE_URL=https://api.tavily.com/search

# ======================
# 私有化 AI（POV-1）：本地 Ollama，数据不出域
# ======================
# 配置 OLLAMA_BASE_URL 后自动注册 ollama provider（无 API Key）：
#   - AI_PROVIDER=ollama 时对话/工具全走本地（其余仍走云端，形成降级链）
#   - 向量检索（AI-5）自动用本地 embedding（/v1/embeddings）
# 本机 Ollama 示例：docker run -d -p 11434:11434 ollama/ollama && ollama pull qwen2.5:7b && ollama pull bge-m3
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=bge-m3

# ======================
# Headless API（AI-19，第三方集成）
# ======================
# 第三方应用调用本基座 Agent 的无头端点（POST /api/v1/headless/chat）
# 请求头 x-api-key 与此值匹配（也接受 Bearer）；留空则该端点返回 401
# HEADLESS_API_KEY=your-headless-api-key

# ======================
# 异常告警 Webhook（RG-4）
# ======================
# 5xx 异常自动推送群机器人（钉钉/飞书/Slack），防抖 60s
# ALERT_WEBHOOK_ENABLED=false
# ALERT_WEBHOOK_URL=                 # 群机器人 webhook 地址
# ALERT_WEBHOOK_TYPE=dingtalk        # dingtalk | feishu | slack
# ALERT_WEBHOOK_MIN_INTERVAL_SECONDS=60

# ======================
# 短信服务（SMS 手机验证）
# ======================
# SMS_DRIVER=console                  # console（验证码打印日志，本地开发/测试）| aliyun（真实服务商，预留）
# 真实服务商凭据到位后启用：
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
