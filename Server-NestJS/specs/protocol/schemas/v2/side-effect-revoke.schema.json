{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "v2/side-effect-revoke.schema.json",
  "title": "AI Tool Side-Effect & Revoke — v2",
  "description": "AI 写副作用清单 item / 执行轨迹 traceItem / 单条撤销结果 / 会话级批量结果（G1）。枚举冻结：status=executed|revoked|revoking_external|revoke_failed；revokeClass=none|local_compensate|governed_external|transactional（KB-6：local_compensate≠governed_external，永不谎称 revoked）；revokeStatus=revoked|compensating|revoke_failed。**v2 变更**：v1 的 item 只固化两视图共有 13 键（且 additionalProperties:true），落后于 D2（Action Center 增 `change` 摘要）/ P0-14（执行轨迹增 `argsHash`+`beforeSnapshot`/`afterSnapshot`）；v2 拆为 item（Action Center，含 change、数据最小化不含快照）与 traceItem（轨迹，含 argsHash + 快照），并收紧 additionalProperties:false。来源：src/ai/tool-effects/ai-tool-effects.service.ts listOwned(403-444) / listForConversation(503-537)；src/ai/interfaces/tool.interface.ts:66-91。",
  "oneOf": [
    { "$ref": "#/definitions/item" },
    { "$ref": "#/definitions/traceItem" },
    { "$ref": "#/definitions/revokeResult" },
    { "$ref": "#/definitions/revokeBatch" }
  ],
  "definitions": {
    "item": {
      "type": "object",
      "required": ["id", "toolName", "resultType", "resultId", "createdAt", "targetExists", "targetSoftDeleted", "targetTitle", "revokeClass", "revokeStatus", "status", "revocable", "change"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "number" },
        "toolName": { "type": "string" },
        "conversationId": { "type": ["string", "null"] },
        "resultType": { "type": "string" },
        "resultId": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "targetExists": { "type": "boolean" },
        "targetSoftDeleted": { "type": "boolean" },
        "targetTitle": { "type": ["string", "null"] },
        "revokeClass": { "enum": ["none", "local_compensate", "governed_external", "transactional"] },
        "revokeStatus": { "type": ["string", "null"], "enum": ["revoked", "compensating", "revoke_failed", null] },
        "status": { "enum": ["executed", "revoked", "revoking_external", "revoke_failed"] },
        "revocable": { "type": "boolean" },
        "change": { "$ref": "#/definitions/changeSummary" }
      }
    },
    "traceItem": {
      "type": "object",
      "required": ["id", "toolName", "resultType", "resultId", "createdAt", "targetExists", "targetSoftDeleted", "targetTitle", "revokeClass", "revokeStatus", "status", "revocable", "argsHash", "beforeSnapshot", "afterSnapshot"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "number" },
        "toolName": { "type": "string" },
        "conversationId": { "type": ["string", "null"] },
        "resultType": { "type": "string" },
        "resultId": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "targetExists": { "type": "boolean" },
        "targetSoftDeleted": { "type": "boolean" },
        "targetTitle": { "type": ["string", "null"] },
        "revokeClass": { "enum": ["none", "local_compensate", "governed_external", "transactional"] },
        "revokeStatus": { "type": ["string", "null"], "enum": ["revoked", "compensating", "revoke_failed", null] },
        "status": { "enum": ["executed", "revoked", "revoking_external", "revoke_failed"] },
        "revocable": { "type": "boolean" },
        "argsHash": { "type": "string" },
        "beforeSnapshot": { "type": ["string", "null"] },
        "afterSnapshot": { "type": ["string", "null"] }
      }
    },
    "changeSummary": {
      "description": "D2：AI 决策证据 ↔ 实际状态变化的紧凑摘要（不回显全量快照，控载荷）",
      "type": "object",
      "required": ["kind", "fields"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["created", "updated", "unknown"] },
        "fields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "revokeResult": {
      "type": "object",
      "required": ["revoked", "effectId"],
      "additionalProperties": true,
      "properties": {
        "revoked": { "type": "boolean" },
        "effectId": { "type": "number" },
        "external": { "type": "boolean" },
        "compensated": { "type": "boolean" },
        "message": { "type": "string" },
        "revokeStatus": { "type": "string", "enum": ["revoked", "compensating", "revoke_failed"] }
      }
    },
    "revokeBatch": {
      "type": "object",
      "required": ["conversationId", "total", "revoked", "skipped", "failed", "results"],
      "additionalProperties": false,
      "properties": {
        "conversationId": { "type": "string" },
        "total": { "type": "number" },
        "revoked": { "type": "number" },
        "skipped": { "type": "number" },
        "failed": { "type": "number" },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["effectId", "revoked"],
            "additionalProperties": true,
            "properties": {
              "effectId": { "type": "number" },
              "revoked": { "type": "boolean" },
              "skipped": { "type": "boolean" },
              "reason": { "enum": ["already_revoked", "compensating"] },
              "revokeStatus": { "type": "string" },
              "external": { "type": "boolean" },
              "message": { "type": "string" },
              "error": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
