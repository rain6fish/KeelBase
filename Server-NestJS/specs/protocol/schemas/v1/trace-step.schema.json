{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "trace-step.schema.json",
  "title": "Conversation Trace Step — v1",
  "description": "GET /ai/conversations/:id/trace 的 data.steps[] 元素（TraceStep）。type 枚举若扩会破坏前端判据——冻结敏感点。来源：src/ai/trace/decision-trace.service.ts:22-66。",
  "type": "object",
  "required": ["id", "type", "time"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "enum": ["input", "assistant", "tool_call", "confirmation", "effect", "notice"] },
    "time": { "type": "string", "format": "date-time" },
    "toolName": { "type": "string" },
    "args": { "type": "string" },
    "success": { "type": "boolean" },
    "errorMessage": { "type": ["string", "null"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "ok"],
        "properties": { "name": { "type": "string" }, "ok": { "type": "boolean" }, "note": { "type": "string" } }
      }
    },
    "outcome": { "enum": ["approve", "decline", "timeout"] },
    "trusted": { "type": "boolean" },
    "content": { "type": "string" },
    "detail": { "type": ["string", "null"] },
    "model": { "type": "string" },
    "provider": { "type": "string" },
    "tokens": { "type": "number" },
    "effect": {
      "$ref": "#/definitions/traceEffect"
    },
    "agentId": { "type": "string" },
    "callerAgentId": { "type": "string" },
    "businessEvent": { "type": ["string", "null"] },
    "evidence": { "type": ["string", "null"] }
  },
  "definitions": {
    "traceEffect": {
      "type": "object",
      "required": ["effectId", "resultType", "resultId", "revocable"],
      "additionalProperties": true,
      "properties": {
        "effectId": { "type": "number" },
        "resultType": { "type": "string" },
        "resultId": { "type": "number" },
        "targetTitle": { "type": ["string", "null"] },
        "revocable": { "type": "boolean" },
        "before": { "type": ["string", "null"] },
        "after": { "type": ["string", "null"] }
      }
    }
  }
}
