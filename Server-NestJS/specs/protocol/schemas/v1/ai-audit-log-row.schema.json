{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "ai-audit-log-row.schema.json",
  "title": "AI Audit Log Row (GET /audit/logs item) — v1",
  "description": "审计查询行（AI 审计链）：AiAuditLog + username 快照投影。行宽于哈希链 payload（audit-payload.schema.json）——id/username/actionKey/actionLabel/feedback/createdAt 为链外表（不入 hash payload，防破链）。来源：src/ai/audit/audit.service.ts _queryLogs（506-567）。",
  "type": "object",
  "required": ["id", "userId", "action", "isError", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "number" },
    "userId": { "type": "string" },
    "conversationId": { "type": ["string", "null"] },
    "action": { "type": "string" },
    "detail": { "type": ["string", "null"] },
    "actionKey": { "type": ["string", "null"] },
    "actionLabel": { "type": ["string", "null"] },
    "agentId": { "type": ["string", "null"] },
    "parentActionId": { "type": ["string", "null"] },
    "callerAgentId": { "type": ["string", "null"] },
    "delegationContext": { "type": ["string", "null"] },
    "businessIntent": { "type": ["string", "null"] },
    "source": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "provider": { "type": ["string", "null"] },
    "promptTokens": { "type": ["number", "null"] },
    "completionTokens": { "type": ["number", "null"] },
    "durationMs": { "type": ["number", "null"] },
    "isError": { "type": "boolean" },
    "errorMessage": { "type": ["string", "null"] },
    "authorization": { "type": ["string", "null"] },
    "feedback": { "type": ["string", "null"] },
    "feedbackNote": { "type": ["string", "null"] },
    "createdAt": { "type": "string" },
    "username": { "type": ["string", "null"] },
    "businessEvent": { "type": ["string", "null"] },
    "evidence": { "type": ["string", "null"] }
  }
}
