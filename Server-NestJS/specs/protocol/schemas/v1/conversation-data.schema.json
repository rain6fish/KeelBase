{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "conversation-data.schema.json",
  "title": "AI 会话视图 ConversationData + Message — v1",
  "description": "GET /ai/conversations 列表项与 GET /ai/conversations/:id 共用视图（toData；列表项只取最近消息）。role 枚举与 timestamp（由 createdAt 派生）为冻结敏感点。来源：src/ai/conversation/conversation.service.ts:23-38、:202-222；src/ai/conversation/ai-message.entity.ts。",
  "type": "object",
  "required": ["id", "provider", "model", "createdAt", "lastActivityAt", "messages"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "userId": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "summary": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "lastActivityAt": { "type": "string", "format": "date-time" },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content", "timestamp"],
        "additionalProperties": false,
        "properties": {
          "role": { "enum": ["system", "user", "assistant", "tool"] },
          "content": { "type": "string" },
          "toolCallId": { "type": "string" },
          "toolName": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
