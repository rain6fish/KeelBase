{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "governance-policy.schema.json",
  "title": "AI Governance Policy (GET/PUT /ai/governance/policy) — v1",
  "description": "治理策略 wire 对象。tools 覆盖全部可选（前端 diff 保存只写差异项）；mode 优先于 legacy requiresConfirmation；R5 恒 blocked 不可放宽；audit.granularity 默认 'all'。revision=sha256(规范化 JSON) 前 12 hex 内容指纹（同内容恒同号）。风险不在此层（风险由工具声明 riskLevel 驱动）。来源：src/ai/governance/governance-policy.service.ts:18-49。",
  "type": "object",
  "required": ["tools", "audit"],
  "additionalProperties": true,
  "properties": {
    "tools": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/toolOverride" }
    },
    "audit": {
      "type": "object",
      "required": ["granularity"],
      "additionalProperties": true,
      "properties": { "granularity": { "enum": ["all", "write", "off"] } }
    },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "revision": { "type": "string" }
  },
  "definitions": {
    "toolOverride": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "requiresConfirmation": { "type": "boolean" },
        "allowedRoles": { "type": "array", "items": { "type": "string" } },
        "mode": { "enum": ["auto", "confirm", "approval"] }
      }
    }
  }
}
