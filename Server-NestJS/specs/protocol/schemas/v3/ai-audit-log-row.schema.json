{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "v3/ai-audit-log-row.schema.json",
  "title": "AI Audit Log Row (GET /audit/logs item) — v3",
  "description": "审计查询行（AI 审计链）：AiAuditLog + username 快照投影。v2（AU-2 §22.19）：新增 `ip`。v3（AU-3 §22.19）：新增 `guestId`（访客标识）——演示端共享账号（alex）下区分不同访客。二者均为**链外归因列**（**不入 hash payload**，防破链；见 §22.19 护栏③）。行宽于哈希链 payload（audit-payload.schema.json）。来源：src/ai/audit/audit.service.ts _queryLogs。v1/v2 冻结历史 → schemas/v1/、schemas/v2/。",
  "type": "object",
  "required": ["id", "userId", "action", "isError", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "number" },
    "userId": { "type": "string" },
    "conversationId": { "type": ["string", "null"] },
    "action": { "type": "string" },
    "detail": { "type": ["string", "null"] },
    "actionKey": { "type": ["string", "null"] },
    "actionLabel": { "type": ["string", "null"] },
    "agentId": { "type": ["string", "null"] },
    "parentActionId": { "type": ["string", "null"] },
    "callerAgentId": { "type": ["string", "null"] },
    "delegationContext": { "type": ["string", "null"] },
    "businessIntent": { "type": ["string", "null"] },
    "source": { "type": ["string", "null"] },
    "ip": { "type": ["string", "null"] },
    "guestId": {
      "description": "AU-3（§22.19）：访客标识（匿名，与账号无关）——区分共享演示账号下的不同访客。链外列，不入 hash payload。",
      "type": ["string", "null"]
    },
    "model": { "type": ["string", "null"] },
    "provider": { "type": ["string", "null"] },
    "promptTokens": { "type": ["number", "null"] },
    "completionTokens": { "type": ["number", "null"] },
    "durationMs": { "type": ["number", "null"] },
    "isError": { "type": "boolean" },
    "errorMessage": { "type": ["string", "null"] },
    "authorization": { "type": ["string", "null"] },
    "feedback": { "type": ["string", "null"] },
    "feedbackNote": { "type": ["string", "null"] },
    "createdAt": { "type": "string" },
    "username": { "type": ["string", "null"] },
    "businessEvent": { "type": ["string", "null"] },
    "evidence": { "type": ["string", "null"] }
  }
}
