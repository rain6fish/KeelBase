# ======================
# 环境
# ======================
NODE_ENV=staging

# ======================
# 服务器配置
# ======================
PORT=3000
CORS_ORIGINS=https://staging.front.app

# ======================
# JWT 认证配置（务必修改以下密钥）
# ======================
JWT_SECRET=change-me-staging-jwt-secret-min-32-chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-staging-refresh-secret-min-32!!
JWT_REFRESH_EXPIRES_IN=7d
# 敏感数据加密密钥（32 字节 hex，必填 64 位）。Joi 里是 .required()，且 staging 只用 .env.staging
# （不带 .env 兜底）⇒ 缺它进程起不来。生成：openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ======================
# 数据库配置 — staging 建议用 PostgreSQL
# ======================
DB_TYPE=postgres
DB_HOST=staging-db.internal
DB_PORT=5432
DB_NAME=front_staging
DB_USER=front_app
DB_PASSWORD=change-me-staging-db-password

# ======================
# 连接池配置
# ======================
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000
