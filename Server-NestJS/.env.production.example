# ======================
# 环境
# ======================
NODE_ENV=production

# ======================
# 服务器配置
# ======================
PORT=3000
CORS_ORIGINS=https://front.app

# ======================
# JWT 认证配置（务必修改以下密钥！！！）
# ======================
JWT_SECRET=change-me-production-jwt-secret-min-32-chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-production-refresh-secret!!-32
JWT_REFRESH_EXPIRES_IN=7d
# 敏感数据加密密钥（32 字节 hex，必填 64 位；部署脚本会自动生成，勿用手动占位符）
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# 审计哈希链 HMAC 密钥（64 位 hex；不配则回退 ENCRYPTION_KEY，建议独立配置）
AUDIT_HMAC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ======================
# 数据库配置（生产环境必须使用 PostgreSQL）
# ======================
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=front_production
DB_USER=front_app
DB_PASSWORD=change-me-production-db-password
# Postgres 容器用（与 DB_NAME/DB_USER/DB_PASSWORD 同步，docker-compose 里 postgres 服务读它）
POSTGRES_DB=front_production
POSTGRES_USER=front_app
POSTGRES_PASSWORD=change-me-production-db-password

# ======================
# 连接池配置
# ======================
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ======================
# 安全设置
# ======================
LOCKOUT_THRESHOLD=10
LOCKOUT_DURATION=15
