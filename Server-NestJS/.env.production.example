# ======================
# 环境
# ======================
NODE_ENV=production

# ======================
# 服务器配置
# ======================
PORT=3000
CORS_ORIGINS=https://front.app

# ======================
# JWT 认证配置（务必修改以下密钥！！！）
# ======================
JWT_SECRET=change-me-production-jwt-secret-min-32-chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-production-refresh-secret!!-32
JWT_REFRESH_EXPIRES_IN=7d
# 敏感数据加密密钥（32 字节 hex，必填 64 位；部署脚本会自动生成，勿用手动占位符）
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# 审计哈希链 HMAC 密钥（64 位 hex；不配则回退 ENCRYPTION_KEY，建议独立配置）
AUDIT_HMAC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# 国密 SM2 私钥（可选，docs/evidence-root.spec.md §11）：配了它证据包导出即双签，第三方持公钥可离线独立验签。
# 建议 KMS/HSM 托管后经环境注入，**私钥不落代码库**；需宿主 openssl 1.1.1+（建议 3.x）。
SM2_PRIVATE_KEY=
SM2_KEY_ID=

# ======================
# 数据库配置（生产环境必须使用 PostgreSQL）
# ======================
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=front_production
DB_USER=front_app
DB_PASSWORD=change-me-production-db-password
# Postgres 容器用（与 DB_NAME/DB_USER/DB_PASSWORD 同步，docker-compose 里 postgres 服务读它）
POSTGRES_DB=front_production
POSTGRES_USER=front_app
POSTGRES_PASSWORD=change-me-production-db-password

# ======================
# 连接池配置
# ======================
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ======================
# 安全设置
# ======================
LOCKOUT_THRESHOLD=10
LOCKOUT_DURATION=15
# 反向代理信任（AU-1 §22.19 审计归因）：决定操作审计 / AI 审计的 ip = 谁。
#   ⚠ 生产务必显式配置——留空虽安全（见下），但若你的拓扑与默认不符会静默丢失真实 IP 归因。
#   未设/空 → 默认只信「回环 + 链路本地 + 私有网段」：自带 nginx / 同机反代开箱得真实客户端 IP；
#             公网直连者不在其中 → 伪造的 X-Forwarded-For 不被采信（取对方真实 socket 地址）
#   推荐：只写自带 nginx 的容器网段，最精确，例如 TRUST_PROXY=172.17.0.0/16
#   0 / false → 不信任任何反代（req.ip 取 socket 地址）；应用直连公网、无反代时用这个
#   数字 N → 信任 N 跳。⚠ 跳数不校验来源，应用可被绕过直连时等于盲信 XFF（审计 IP 可伪造）
#   ⚠ 不得设 true（= 盲信任意 X-Forwarded-For）；设了会被拒绝并打印告警
TRUST_PROXY=
